{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": ".temp/compiled",
    "rootDir": ".",
    "declaration": true,
    "composite": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "tsBuildInfoFile": ".temp/rayfin.tsbuildinfo"
  },
  "include": [
    "data/**/*.ts"
  ],
  "exclude": [
    ".temp/**/*",
    "functions/**/*"
  ]
}
